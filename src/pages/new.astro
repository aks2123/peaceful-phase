<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Forma — Neuroradiology Education</title>
        <style>
            @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Manrope:wght@400;500;600;650;700;750;800&display=swap");
            :root {
                --bg: #f5f6f8;
                --surface: #fff;
                --ink: #17232d;
                --muted: #78838d;
                --line: #e6eaed;
                --accent: #177f73;
                --soft: #e9f4f0;
                --nav: #142c35;
                --radius: 18px;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font-family: "DM Sans", sans-serif;
                font-size: 14px;
            }
            button,
            a,
            input {
                font: inherit;
            }
            button,
            a {
                -webkit-tap-highlight-color: transparent;
            }
            a {
                color: inherit;
                text-decoration: none;
            }
            button {
                cursor: pointer;
            }
            button:focus-visible,
            a:focus-visible,
            input:focus-visible {
                outline: 3px solid #68cdb5;
                outline-offset: 4px;
            }
            .app {
                display: grid;
                grid-template-columns: 238px 1fr;
                min-height: 100vh;
            }
            .sidebar {
                position: fixed;
                inset: 0 auto 0 0;
                width: 238px;
                background: var(--nav);
                color: #9fb3ba;
                padding: 38px 23px;
                display: flex;
                flex-direction: column;
                z-index: 20;
            }
            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                color: white;
                font:
                    800 27px "Manrope",
                    sans-serif;
                letter-spacing: -1.3px;
            }
            .brand-icon {
                width: 30px;
                height: 34px;
                display: grid;
                place-items: center;
                color: #8dd6c2;
            }
            .brand small {
                font-size: 9px;
                letter-spacing: 2px;
                color: #9fb3ba;
                display: block;
                font-weight: 500;
                margin-top: 4px;
            }
            .nav-label {
                font-size: 10px;
                letter-spacing: 1.8px;
                font-weight: 700;
                margin: 49px 14px 16px;
                color: #77929c;
            }
            .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 13px 14px;
                margin: 5px 0;
                border-radius: 9px;
                font-size: 13px;
                transition: 0.2s;
            }
            .nav-link:hover {
                background: #ffffff0b;
                color: white;
            }
            .nav-link.active {
                background: #ffffff10;
                color: #c0eedc;
            }
            .nav-link svg {
                width: 18px;
                height: 18px;
            }
            .nav-link .count {
                margin-left: auto;
                font-size: 10px;
                background: #ffffff12;
                padding: 3px 6px;
                border-radius: 5px;
            }
            .side-bottom {
                margin-top: auto;
                padding-top: 45px;
            }
            .side-note {
                border: 1px solid #ffffff18;
                border-radius: 12px;
                padding: 18px 15px;
                font-size: 11px;
                line-height: 1.7;
                color: #91aab3;
            }
            .side-note strong {
                display: block;
                color: #e4efed;
                font-size: 12px;
                margin-bottom: 6px;
            }
            .side-footer {
                font-size: 10px;
                margin: 22px 12px 0;
                color: #6d8994;
            }
            .main {
                grid-column: 2;
                min-width: 0;
            }
            .topbar {
                height: 86px;
                border-bottom: 1px solid var(--line);
                background: #ffffffa6;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 48px;
                gap: 20px;
            }
            .crumb {
                font-size: 12px;
                color: var(--muted);
            }
            .crumb span {
                margin: 0 12px;
                color: #bec5ca;
            }
            .crumb b {
                font-weight: 500;
                color: #43525e;
            }
            .top-tools {
                display: flex;
                align-items: center;
                gap: 22px;
            }
            .search {
                display: flex;
                gap: 9px;
                align-items: center;
                color: #9aa5ad;
            }
            .search input {
                border: 0;
                background: transparent;
                width: 150px;
                outline: none;
                font-size: 12px;
                color: var(--ink);
            }
            .search svg {
                width: 16px;
                height: 16px;
            }
            .avatar {
                height: 33px;
                width: 33px;
                border-radius: 50%;
                background: #e5ecea;
                color: #527268;
                display: grid;
                place-items: center;
                font-size: 10px;
                font-weight: 700;
            }
            .content {
                max-width: 1370px;
                padding: 43px 48px 25px;
                margin: auto;
            }
            .eyebrow {
                color: var(--accent);
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
            }
            .heading {
                display: flex;
                justify-content: space-between;
                align-items: end;
                gap: 20px;
                margin-bottom: 28px;
            }
            h1 {
                font:
                    650 clamp(26px, 3vw, 37px) / 1.2 "Manrope",
                    sans-serif;
                letter-spacing: -1.4px;
                margin: 10px 0 10px;
            }
            p {
                color: var(--muted);
                line-height: 1.7;
                margin: 0;
            }
            .heading p {
                font-size: 13px;
            }
            .date-label {
                font-size: 11px;
                color: var(--muted);
                white-space: nowrap;
                padding-bottom: 4px;
            }
            .hero {
                position: relative;
                overflow: hidden;
                border-radius: var(--radius);
                background: #e8f0ee;
                min-height: 284px;
                display: grid;
                grid-template-columns: 1.1fr 1fr;
                border: 1px solid #dfe9e4;
            }
            .hero-copy {
                padding: 35px 36px;
                z-index: 1;
            }
            .pill {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                font-size: 9px;
                letter-spacing: 1.2px;
                text-transform: uppercase;
                color: #39675d;
                font-weight: 700;
            }
            .pill:before {
                content: "";
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #438e78;
            }
            .hero h2 {
                font:
                    600 31px/1.25 "Manrope",
                    sans-serif;
                letter-spacing: -1px;
                max-width: 370px;
                margin: 17px 0 12px;
            }
            .hero p {
                font-size: 12px;
                max-width: 330px;
                color: #6b827c;
            }
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 17px;
                background: var(--ink);
                color: white;
                border: 0;
                padding: 12px 18px;
                border-radius: 7px;
                font-size: 11px;
                font-weight: 600;
            }
            .btn:hover {
                background: #285449;
            }
            .hero .btn {
                margin-top: 24px;
            }
            .arrow {
                font-size: 16px;
                line-height: 1;
            }
            .hero-art {
                position: relative;
                display: grid;
                place-items: center;
                min-height: 260px;
                background: radial-gradient(ellipse, #cddfd7 0%, transparent 66%);
            }
            .hero-art:before,
            .hero-art:after {
                content: "";
                position: absolute;
                width: 220px;
                height: 220px;
                border: 1px solid #9ab4aa40;
                border-radius: 50%;
            }
            .hero-art:after {
                width: 290px;
                height: 290px;
            }
            .brain {
                width: 250px;
                height: 245px;
                z-index: 1;
                filter: drop-shadow(0 12px 12px #254d3920);
            }
            .art-tag {
                position: absolute;
                font-size: 8px;
                letter-spacing: 1.3px;
                color: #839d93;
                bottom: 23px;
                right: 24px;
            }
            .stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                background: var(--surface);
                border: 1px solid var(--line);
                border-radius: 13px;
                margin: 23px 0 35px;
                padding: 21px 0;
            }
            .stat {
                padding: 0 25px;
                display: flex;
                align-items: center;
                gap: 15px;
                border-right: 1px solid var(--line);
            }
            .stat:last-child {
                border: 0;
            }
            .stat-icon {
                width: 37px;
                height: 37px;
                border-radius: 10px;
                background: #f2f6f4;
                display: grid;
                place-items: center;
                color: #719184;
            }
            .stat-icon svg {
                width: 18px;
                height: 18px;
            }
            .stat strong {
                font:
                    700 21px "Manrope",
                    sans-serif;
            }
            .stat span {
                display: block;
                font-size: 10px;
                color: var(--muted);
                margin-top: 4px;
            }
            .section-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
                gap: 15px;
            }
            .section-head h2 {
                font:
                    700 18px "Manrope",
                    sans-serif;
                letter-spacing: -0.4px;
                margin: 0;
            }
            .text-link {
                font-size: 11px;
                color: var(--accent);
                background: none;
                border: 0;
                padding: 5px 0;
            }
            .filters {
                display: flex;
                gap: 7px;
                margin-bottom: 21px;
                flex-wrap: wrap;
            }
            .filter {
                font-size: 11px;
                background: none;
                border: 1px solid transparent;
                color: var(--muted);
                padding: 8px 14px;
                border-radius: 6px;
            }
            .filter.active {
                background: white;
                color: #305e52;
                border-color: var(--line);
                box-shadow: 0 2px 3px #00000002;
            }
            .cards {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 17px;
            }
            .card {
                border: 1px solid var(--line);
                border-radius: 12px;
                background: white;
                overflow: hidden;
                transition:
                    transform 0.2s,
                    box-shadow 0.2s;
                display: flex;
                flex-direction: column;
            }
            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 25px #163e3010;
            }
            .card-art {
                height: 125px;
                background: #edf1f1;
                position: relative;
                overflow: hidden;
                display: grid;
                place-items: center;
            }
            .card:nth-child(2) .card-art {
                background: #eeedf2;
            }
            .card:nth-child(3) .card-art {
                background: #eaf1ee;
            }
            .mini-brain {
                width: 115px;
                height: 115px;
                opacity: 0.9;
            }
            .card-index {
                position: absolute;
                top: 15px;
                left: 17px;
                color: #8b9998;
                font-size: 9px;
                letter-spacing: 1px;
            }
            .card-level {
                position: absolute;
                top: 13px;
                right: 13px;
                background: #ffffffaa;
                padding: 4px 7px;
                border-radius: 4px;
                font-size: 8px;
                color: #5d726e;
            }
            .card-body {
                padding: 19px;
                display: flex;
                flex-direction: column;
                flex: 1;
            }
            .category {
                font-size: 8px;
                color: var(--accent);
                letter-spacing: 1.3px;
                text-transform: uppercase;
                font-weight: 700;
            }
            .card h3 {
                font:
                    700 15px "Manrope",
                    sans-serif;
                letter-spacing: -0.3px;
                margin: 9px 0;
            }
            .card p {
                font-size: 11px;
                line-height: 1.7;
                margin-bottom: 20px;
            }
            .card-meta {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-top: 1px solid #f0f2f3;
                padding-top: 13px;
                margin-top: auto;
                font-size: 9px;
                color: #8a969d;
            }
            .card-meta span:last-child {
                font-size: 17px;
                color: #476e60;
            }
            .bottom-banner {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                border: 1px solid var(--line);
                border-radius: 12px;
                padding: 21px 25px;
                background: white;
                margin-top: 27px;
            }
            .bottom-banner h3 {
                font:
                    700 13px "Manrope",
                    sans-serif;
                margin: 0 0 6px;
            }
            .bottom-banner p {
                font-size: 11px;
            }
            .outline-btn {
                background: white;
                border: 1px solid var(--line);
                color: #38594e;
                white-space: nowrap;
            }
            .footer {
                display: flex;
                justify-content: space-between;
                color: #9aa4ab;
                font-size: 9px;
                margin-top: 35px;
                padding-top: 18px;
                border-top: 1px solid var(--line);
                gap: 20px;
            }
            .menu-btn {
                display: none;
                background: none;
                border: 0;
                color: var(--ink);
                font-size: 21px;
            }
            .lesson-layout {
                display: grid;
                grid-template-columns: 1fr 235px;
                gap: 25px;
                margin-top: 27px;
            }
            .article {
                background: white;
                border: 1px solid var(--line);
                border-radius: 14px;
                padding: 32px;
            }
            .article h2 {
                font:
                    700 20px "Manrope",
                    sans-serif;
                margin: 0 0 17px;
            }
            .article h3 {
                font:
                    700 15px "Manrope",
                    sans-serif;
                margin: 28px 0 12px;
            }
            .article p,
            .article li {
                font-size: 13px;
                color: var(--muted);
                line-height: 1.9;
            }
            .article li {
                margin-bottom: 9px;
            }
            .placeholder {
                margin: 24px 0;
                padding: 35px 20px;
                background: #f0f4f2;
                border: 1px dashed #c7d9d0;
                border-radius: 10px;
                text-align: center;
            }
            .placeholder .mini-brain {
                width: 135px;
                height: 135px;
            }
            .placeholder p {
                font-size: 11px;
                margin-top: 10px;
            }
            .toc {
                background: white;
                border: 1px solid var(--line);
                border-radius: 12px;
                padding: 22px;
                height: fit-content;
            }
            .toc h3 {
                font-size: 11px;
                margin: 0 0 17px;
            }
            .toc a {
                display: block;
                font-size: 11px;
                color: var(--muted);
                padding: 9px 0;
            }
            .note {
                padding: 17px;
                background: var(--soft);
                border-left: 3px solid #6ba68f;
                border-radius: 4px;
                font-size: 12px;
                line-height: 1.8;
                color: #527267;
            }
            .empty {
                padding: 40px;
                border: 1px dashed #ccd8d2;
                border-radius: 12px;
                text-align: center;
                color: var(--muted);
                grid-column: 1/-1;
            }
            .back {
                font-size: 11px;
                color: var(--accent);
                display: inline-block;
                margin-bottom: 22px;
            }
            .sr-only {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
            }
            @media (min-width: 1500px) {
                .content {
                    padding-top: 55px;
                }
                .hero {
                    min-height: 310px;
                }
                .card-art {
                    height: 150px;
                }
            }
            @media (max-width: 1100px) {
                .sidebar {
                    width: 205px;
                    padding: 32px 17px;
                }
                .app {
                    grid-template-columns: 205px 1fr;
                }
                .content {
                    padding: 30px;
                }
                .topbar {
                    padding: 0 30px;
                }
                .hero-copy {
                    padding: 30px;
                }
                .hero h2 {
                    font-size: 26px;
                }
                .brain {
                    width: 200px;
                }
                .cards {
                    gap: 12px;
                }
                .card-body {
                    padding: 15px;
                }
                .stat {
                    padding: 0 17px;
                    gap: 10px;
                }
                .lesson-layout {
                    grid-template-columns: 1fr;
                }
                .toc {
                    display: none;
                }
            }
            @media (max-width: 800px) {
                .sidebar {
                    transform: translateX(-100%);
                    transition: transform 0.2s;
                    width: 238px;
                    box-shadow: 10px 0 50px #0002;
                }
                .sidebar.open {
                    transform: translateX(0);
                }
                .app {
                    display: block;
                }
                .topbar {
                    height: 70px;
                    padding: 0 22px;
                }
                .menu-btn {
                    display: block;
                }
                .top-tools {
                    gap: 12px;
                }
                .search input {
                    width: 115px;
                }
                .content {
                    padding: 28px 22px;
                }
                .crumb {
                    margin-right: auto;
                }
                .crumb span,
                .crumb b {
                    display: none;
                }
                .cards {
                    grid-template-columns: repeat(2, 1fr);
                }
                .date-label {
                    display: none;
                }
                .hero-art {
                    min-height: 230px;
                }
                .hero-copy {
                    padding: 27px;
                }
                .hero h2 {
                    font-size: 25px;
                }
                .hero-art:after {
                    width: 220px;
                    height: 220px;
                }
                .brain {
                    width: 180px;
                }
                .stat {
                    padding: 0 13px;
                }
                .stat-icon {
                    display: none;
                }
                .stat strong {
                    font-size: 19px;
                }
                .heading {
                    margin-bottom: 23px;
                }
            }
            @media (max-width: 520px) {
                .topbar {
                    gap: 12px;
                }
                .search input {
                    width: 100px;
                }
                .avatar {
                    display: none;
                }
                .hero {
                    grid-template-columns: 1fr;
                }
                .hero-copy {
                    padding: 27px 25px;
                }
                .hero-art {
                    display: none;
                }
                .hero h2 {
                    max-width: 270px;
                    font-size: 29px;
                }
                .hero p {
                    max-width: 280px;
                }
                .cards {
                    grid-template-columns: 1fr;
                }
                .card-art {
                    height: 145px;
                }
                .card-body {
                    padding: 21px;
                }
                .stats {
                    padding: 17px 0;
                    margin-bottom: 28px;
                }
                .stat {
                    padding: 0 12px;
                }
                .stat strong {
                    font-size: 18px;
                }
                .stat span {
                    font-size: 9px;
                }
                .bottom-banner {
                    align-items: start;
                    padding: 20px;
                    flex-direction: column;
                }
                .footer {
                    line-height: 1.7;
                }
                .article {
                    padding: 23px;
                }
                .heading h1 {
                    font-size: 28px;
                }
            }
            @media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                    scroll-behavior: auto !important;
                }
            }
        </style>
    </head>
    <body>
